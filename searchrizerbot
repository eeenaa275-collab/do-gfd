async def do_broadcast(text, status_msg=None):
    global broadcast
    broadcast = {"running": True, "text": text, "total": len(users), "sent": 0, "failed": 0}
    save_broadcast()
    last_edit = [0.0]

    for uid in list(users.keys()):
        try:
            await client.send_message(int(uid), text, parse_mode="html")
            broadcast["sent"] += 1
        except Exception:
            broadcast["failed"] += 1
        if status_msg and time.time() - last_edit[0] > 2:
            last_edit[0] = time.time()
            p = (broadcast["sent"] + broadcast["failed"]) * 100 // max(1, broadcast["total"])
            try:
                await status_msg.edit(
                    "📢 <b>РАССЫЛКА</b>\n"
                    "━━━━━━━━━━━━━━━━━━\n"
                    f"{bar(p)} {p}%\n"
                    f"✅ Отправлено: <b>{broadcast['sent']}</b>\n"
                    f"❌ Ошибок: <b>{broadcast['failed']}</b>\n"
                    f"👥 Всего: <b>{broadcast['total']}</b>",
                    parse_mode="html")
            except Exception:
                pass
        await asyncio.sleep(0.05)

    broadcast["running"] = False
    save_broadcast()


