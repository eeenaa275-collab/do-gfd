def has_sub(u):
    return int(u.get("sub_until", 0)) > int(time.time())


def sub_time_left(u):
    left = int(u.get("sub_until", 0)) - int(time.time())
    return max(0, left)


def human_time(sec):
    sec = int(sec)
    d = sec // 86400
    h = sec % 86400 // 3600
    m = sec % 3600 // 60
    if d > 0:
        return f"{d} д {h} ч"
    if h > 0:
        return f"{h} ч {m} мин"
    return f"{m} мин"


def free_left(u):
    if u.get("last_free") != today_msk():
        return DAILY_FREE
    return max(0, DAILY_FREE - u.get("used_today", 0))


def total_left(u):
    if has_sub(u):
        return 999999
    return free_left(u) + int(u.get("balance", 0))


def consume_query(u):
    if has_sub(u):
        u["total_searches"] = u.get("total_searches", 0) + 1
        save_users()
        return True
    today = today_msk()
    if u.get("last_free") != today:
        u["last_free"] = today
        u["used_today"] = 0
    if u.get("used_today", 0) < DAILY_FREE:
        u["used_today"] = u.get("used_today", 0) + 1
        u["total_searches"] = u.get("total_searches", 0) + 1
        save_users()
        return True
    if int(u.get("balance", 0)) > 0:
        u["balance"] = int(u["balance"]) - 1
        u["total_searches"] = u.get("total_searches", 0) + 1
        save_users()
        return True
    return False


def add_sub(uid, days):
