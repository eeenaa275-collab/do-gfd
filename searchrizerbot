def extract(path, dest):
    n = path.lower()
    os.makedirs(dest, exist_ok=True)
    if n.endswith(".zip"):
        with zipfile.ZipFile(path) as z:
            z.extractall(dest)
    elif n.endswith((".7z", ".rar")):
        try:
            if n.endswith(".7z"):
                import py7zr
                with py7zr.SevenZipFile(path) as z:
                    z.extractall(dest)
            else:
                import rarfile
                with rarfile.RarFile(path) as z:
                    z.extractall(dest)
        except ImportError:
            exe = shutil.which("7z") or shutil.which("7za") or shutil.which("7zz")
            if not exe:
                raise RuntimeError("нет 7z: pkg install p7zip")
            subprocess.run([exe, "x", "-y", f"-o{dest}", path], check=True,
                           stdout=subprocess.DEVNULL)
    elif n.endswith((".tar", ".tgz", ".tar.gz", ".tar.bz2", ".tbz2", ".tar.xz", ".txz")):
        with tarfile.open(path) as t:
            t.extractall(dest)
    elif n.endswith((".gz", ".bz2", ".xz")):
        op = {".gz": gzip.open, ".bz2": bz2.open, ".xz": lzma.open}[os.path.splitext(n)[1]]
        with op(path, "rb") as s, open(os.path.join(dest, os.path.basename(path).rsplit(".", 1)[0]), "wb") as d:
            shutil.copyfileobj(s, d)


def to_text(path, out):
    low = path.lower()
    if low.endswith((".xlsx", ".xlsm")):
        import openpyxl
        wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
        for ws in wb.worksheets:
            for row in ws.iter_rows(values_only=True):
                out.write("\t".join("" if c is None else str(c) for c in row) + "\n")
    elif low.endswith(".docx"):
        import docx
        d = docx.Document(path)
        for p in d.paragraphs:
            out.write(p.text + "\n")
        for t in d.tables:
            for r in t.rows:
                out.write("\t".join(c.text for c in r.cells) + "\n")
    elif low.endswith(".pdf"):
        from pypdf import PdfReader
        for pg in PdfReader(path).pages:
            out.write((pg.extract_text() or "") + "\n")
    else:
        with open(path, "rb") as f:
            head = f.read(65536)
        if b"\x00" in head:
            return False
        enc = chardet.detect(head)["encoding"] or "utf-8"
        with open(path, "r", encoding=enc, errors="replace") as f:
            shutil.copyfileobj(f, out, 1 << 20)
    return True


def process_upload(src, name, dbname):
    dest = os.path.join(DB_DIR, dbname)
    os.makedirs(dest, exist_ok=True)
    st = {"added": 0, "skipped": 0, "bytes": 0}

    def handle(path, rel, depth):
        if is_archive(path) and depth < MAX_DEPTH:
            try:
                d = path + "_x"
                extract(path, d)
                for r, _, fs in os.walk(d):
                    for fn in fs:
                        p = os.path.join(r, fn)
                        handle(p, os.path.relpath(p, d), depth + 1)
            except Exception:
                st["skipped"] += 1
            return
        out_path = os.path.join(dest, safe(rel.replace(os.sep, "__")))
        if os.path.exists(out_path):
            out_path += f"_{int(time.time() * 1000)}"
        try:
            with open(out_path, "w", encoding="utf-8", newline="\n") as out:
                ok = to_text(path, out)
        except Exception:
            ok = False
        if ok:
            st["added"] += 1
            st["bytes"] += os.path.getsize(out_path)
        else:
            st["skipped"] += 1
            if os.path.exists(out_path):
                os.remove(out_path)

    handle(src, name, 0)
    return st


