def py_scan(q, target):
    ql = q.lower()
    root = os.path.join(DB_DIR, target) if target != "." else DB_DIR
    for r, _, fs in os.walk(root):
        for fn in fs:
            p = os.path.join(r, fn)
            rel = os.path.relpath(p, DB_DIR)
            with open(p, "r", encoding="utf-8", errors="replace") as f:
                for line in f:
                    if ql in line.lower():
                        yield f"{rel}:{line.rstrip(chr(10))}"


def run_search(query, dbname):
    t0 = time.time()
    res_path = os.path.join(tempfile.mkdtemp(dir=TMP_DIR), "results.txt")
    target = dbname or "."
    variants = {query, query.lower(), query.upper(), query.capitalize(), query.title(), query.swapcase()}
    if shutil.which("grep"):
        cmd = ["grep", "-r", "-a", "-i", "-F", "-H"]
        for v in variants:
            cmd += ["-e", v]
        cmd += ["--", target]
        proc = subprocess.Popen(cmd, cwd=DB_DIR, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        it = (l.decode("utf-8", "replace").rstrip("\n") for l in proc.stdout)
    else:
        proc = None
        it = py_scan(query, target)

    count, preview, seen = 0, [], set()
    with open(res_path, "w", encoding="utf-8") as out:
        for line in it:
            path, _, text = line.partition(":")
            path = path[2:] if path.startswith("./") else path
            base, _, fname = path.partition("/")
            key = hash((base, text))
            if key in seen:
                continue
            seen.add(key)
            count += 1
            out.write(f"[{base}/{fname}] {text}\n")
            if len(preview) < PREVIEW:
                preview.append((base, fname, text))
            if count >= MAX_RESULTS:
                break
    if proc:
        proc.kill()
    return count, preview, res_path, time.time() - t0


