def make_graph(values, width=20):
    if not values:
        return "нет данных"
    mx = max(v for _, v in values) or 1
    lines = []
    for label, v in values:
        n = int(round(v / mx * width)) if mx else 0
        lines.append(f"{label} │{'█' * n}{'░' * (width - n)}│ {v}")
    return "\n".join(lines)


