@client.on(events.NewMessage(func=lambda e: e.is_private and not e.document
                             and e.text and not e.text.startswith("/")))
async def search(e):
    q = e.text.strip()
    uid = str(e.sender_id)
    uname = (await e.get_sender()).username or ""
    u = get_user(uid, uname)

    # BAN
    if is_banned(u) and not is_owner(e):
        await e.reply(
            f"🚫 <b>Ты забанен.</b>\n"
            f"Причина: {esc(u.get('ban_reason') or 'не указана')}",
            parse_mode="html")
        return

    # Промокод
    if WAIT_PROMO.get(uid):
        WAIT_PROMO.pop(uid, None)
        code = q.strip().upper()
        if code in promos and promos[code].get("left", 0) > 0:
            amount = int(promos[code]["left"])
            u["balance"] = int(u.get("balance", 0)) + amount
            promos[code]["left"] = 0
            promos[code]["uses"] = promos[code].get("uses", 0) + 1
            save_users()
            save_promos()
            await e.reply(
                "🎉 <b>ПРОМОКОД АКТИВИРОВАН!</b>\n"
                "━━━━━━━━━━━━━━━━━━\n"
                f"🎟 Код: <code>{esc(code)}</code>\n"
                f"💠 Начислено: <b>+{amount}</b>\n"
                f"💎 Бонусный баланс: <b>{u['balance']}</b>",
                buttons=[[Button.inline("🔎 Искать", b"find"), Button.inline("⬅️ В меню", b"menu")]],
                parse_mode="html")
        else:
            await e.reply(
                "❌ <b>Неверный или использованный промокод.</b>",
                buttons=[[Button.inline("🎟 Ещё раз", b"promo_enter"), Button.inline("⬅️ В меню", b"menu")]],
                parse_mode="html")
        return

    # Создание промокода
    if WAIT_PROMO_CREATE.get(uid):
        step = WAIT_PROMO_CREATE[uid]
        if step == "amount":
            if not q.isdigit() or int(q) <= 0:
                await e.reply("❌ Введи положительное число.", buttons=BACK, parse_mode="html")
                return
            WAIT_PROMO_CREATE[uid] = ("gen", int(q))
            await e.reply(
                "🎟 <b>СОЗДАНИЕ ПРОМОКОДА</b>\n"
                f"💠 Запросов: <b>{q}</b>\n\n"
                "Отправь текст кода (напр. <code>OSINT50</code>)\n"
                "или напиши <code>auto</code>.",
                buttons=BACK, parse_mode="html")
            return
        elif isinstance(step, tuple) and step[0] == "gen":
            amount = step[1]
            code = q.strip().upper() if q.strip().lower() != "auto" else gen_code()
            if code in promos:
                await e.reply("❌ Такой промокод уже есть.", buttons=BACK, parse_mode="html")
                return
            promos[code] = {"uses": 0, "left": amount, "created": int(time.time())}
            save_promos()
            WAIT_PROMO_CREATE.pop(uid, None)
            await e.reply(
                "✅ <b>ПРОМОКОД СОЗДАН</b>\n"
                f"🎟 Код: <code>{esc(code)}</code>\n"
                f"💠 Запросов: <b>{amount}</b>",
                buttons=[[Button.inline("🎟 К промокодам", b"promo_menu"), Button.inline("⬅️ В меню", b"menu")]],
                parse_mode="html")
            return

    # Рассылка
    if WAIT_BC.get(uid):
        WAIT_BC.pop(uid, None)
        text = q
        msg = await e.reply(
            "📢 <b>РАССЫЛКА ЗАПУЩЕНА</b>\n"
            "━━━━━━━━━━━━━━━━━━\n"
            f"{bar(0)} 0%\n"
            f"✅ Отправлено: <b>0</b>\n"
            f"❌ Ошибок: <b>0</b>\n"
            f"👥 Всего: <b>{len(users)}</b>",
            parse_mode="html")
        asyncio.create_task(do_broadcast(text, msg))
        return

    # Бан: ID
    if WAIT_BAN_ID.get(uid):
        WAIT_BAN_ID.pop(uid, None)
        target = q.strip().lstrip("@")
        if target not in users:
            await e.reply("❌ Не найден. Введи ID или @username.", buttons=BACK, parse_mode="html")
            return
        WAIT_BAN_REASON[uid] = target
        await e.reply(
            f"🚫 <b>БАН ЮЗЕРА</b>\n"
            f"👤 ID: <code>{target}</code>\n\n"
            "Отправь причину бана (или <code>-</code> чтобы без причины):",
            buttons=[[Button.inline("⬅️ Отмена", b"user_menu")]],
            parse_mode="html")
        return

    # Бан: причина
    if WAIT_BAN_REASON.get(uid):
        target = WAIT_BAN_REASON.pop(uid, None)
        reason = "" if q.strip() == "-" else q.strip()
        if target in users:
            users[target]["banned"] = True
            users[target]["ban_reason"] = reason
            save_users()
        await e.reply(
            f"✅ <b>Юзер <code>{target}</code> забанен</b>\n"
            f"Причина: {esc(reason or '—')}",
            buttons=[[Button.inline("⬅️ В меню", b"menu")]],
            parse_mode="html")
        return

    # Разбан
    if WAIT_UNBAN_ID.get(uid):
        WAIT_UNBAN_ID.pop(uid, None)
        target = q.strip().lstrip("@")
        if target not in users:
            await e.reply("❌ Не найден.", buttons=BACK, parse_mode="html")
            return
        users[target]["banned"] = False
        users[target]["ban_reason"] = ""
        save_users()
        await e.reply(
            f"✅ <b>Юзер <code>{target}</code> разбанен</b>",
            buttons=[[Button.inline("⬅️ В меню", b"menu")]],
            parse_mode="html")
        return

    # Выдача подписки: ID
    if WAIT_SUB_ID.get(uid):
        WAIT_SUB_ID.pop(uid, None)
        target = q.strip().lstrip("@")
        if target not in users:
            await e.reply("❌ Не найден.", buttons=BACK, parse_mode="html")
            return
        WAIT_SUB_DAYS[uid] = target
        rows = []
        for key, cfg in SUB_PRICES.items():
            rows.append([Button.inline(f"{cfg['name']} · {cfg['days']} дн.", f"subg:{key}".encode())])
        rows.append([Button.inline("⬅️ Отмена", b"user_menu")])
        await e.reply(
            f"💎 <b>ВЫДАЧА ПОДПИСКИ</b>\n"
            f"👤 Юзер: <code>{target}</code>\n\n"
            "Выбери срок:",
            buttons=rows, parse_mode="html")
        return

    # Обычный поиск
    if not list_bases():
        await e.reply("📭 <b>Баз пока нет.</b>", parse_mode="html")
        return

    if not is_owner(e) and total_left(u) <= 0:
        await e.reply(
            "💔 <b>Запросы закончились!</b>\n"
            "━━━━━━━━━━━━━━━━━━\n"
            f"🎁 Бесплатных сегодня: <b>0</b> / {DAILY_FREE}\n"
            f"💠 Бонусных: <b>0</b>\n\n"
            "🎟 Активировать промокод\n"
            f"🤝 Пригласить друга (+{REF_BONUS})\n"
            "💎 Купить подписку\n"
            "⏰ Или подождать до 00:00 МСК.",
            buttons=[[Button.inline("🎟 Промокод", b"promo_enter"),
                      Button.inline("💎 Подписка", b"sub_menu")],
                     [Button.inline("🤝 Рефералы", b"ref"),
                      Button.inline("🆘 Поддержка", b"support")],
                     [Button.inline("⬅️ В меню", b"menu")]],
            parse_mode="html")
        return

    db = scope["db"]
    if db and not os.path.isdir(os.path.join(DB_DIR, db)):
        scope["db"] = db = None

    if not is_owner(e):
        consume_query(u)
    stats['searches'] += 1
    stats['last_query'] = q[:60]
    save_stats()
    touch_history("searches")
    mark_active(uid)

    msg = await e.reply(f"🔎 <b>Ищу:</b> <code>{esc(q)}</code>…", parse_mode="html")
    count, preview, path, took = await asyncio.get_running_loop().run_in_executor(None, run_search, q, db)

    left_info = ""
    if not is_owner(e):
        if has_sub(u):
            left_info = f"\n👑 Подписка: <b>{human_time(sub_time_left(u))}</b>"
        else:
            left_info = (f"\n🎁 Осталось сегодня: <b>{free_left(u)}</b>"
