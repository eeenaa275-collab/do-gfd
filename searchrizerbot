@client.on(events.NewMessage(pattern=r"^/(start|menu|admin)", func=lambda e: e.is_private))
async def start(e):
    uid = str(e.sender_id)
    uname = (await e.get_sender()).username or ""
    u = get_user(uid, uname)

    if is_banned(u):
        await e.reply(
            f"🚫 <b>Ты забанен.</b>\n"
            f"Причина: {esc(u.get('ban_reason') or 'не указана')}",
            parse_mode="html")
        return

    args = e.text.split(maxsplit=1)
    if len(args) > 1 and args[1].startswith("ref_"):
        ref_id = args[1][4:]
        if ref_id.isdigit() and ref_id != uid and ref_id in users:
            if not u.get("ref_by"):
                u["ref_by"] = ref_id
                u["balance"] = int(u.get("balance", 0)) + REF_BONUS
                users[ref_id]["balance"] = int(users[ref_id].get("balance", 0)) + REF_BONUS
                if uid not in users[ref_id].get("refs", []):
                    users[ref_id].setdefault("refs", []).append(uid)
                save_users()
                try:
                    await client.send_message(
                        int(ref_id),
                        f"🤝 <b>Новый реферал!</b>\n"
                        f"👤 {esc(uname or 'id'+uid)} присоединился.\n"
                        f"💠 Тебе <b>+{REF_BONUS}</b>, ему тоже <b>+{REF_BONUS}</b>.",
                        parse_mode="html")
                except Exception:
                    pass
                await e.reply(
                    f"🎉 <b>Добро пожаловать!</b>\n"
                    f"Ты пришёл по реферальной ссылке и получил <b>+{REF_BONUS}</b> запросов.",
                    parse_mode="html")

    mark_active(uid)

    owner = is_owner(e)
    text = menu_text(owner, uid)
    btns = menu_buttons(owner)

    if os.path.exists(LOGO_PATH):
        try:
            await client.send_file(e.chat_id, LOGO_PATH, caption=text,
                                   buttons=btns, parse_mode="html")
            return
        except Exception:
            pass
    await e.reply(text, buttons=btns, parse_mode="html")


