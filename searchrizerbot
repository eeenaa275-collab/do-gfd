@client.on(events.NewMessage(func=lambda e: e.is_private and e.document))
async def upload(e):
    if not is_owner(e):
        u = get_user(e.sender_id)
        if is_banned(u):
            await e.reply("🚫 Ты забанен.", parse_mode="html")
            return
        await e.reply("⛔ <b>Загрузка баз доступна только администратору.</b>", parse_mode="html")
        return
    name = (e.file.name if e.file and e.file.name else "file")
    dbname = safe(e.text) if e.text else safe(os.path.splitext(name)[0])
    msg = await e.reply(f"📥 <b>Принимаю</b> {esc(name)}…", parse_mode="html")
    work = tempfile.mkdtemp(dir=TMP_DIR)
    last = [0.0]

    async def cb(cur, total):
        if time.time() - last[0] < 3:
            return
        last[0] = time.time()
        p = cur * 100 // total if total else 0
        try:
            await msg.edit(f"📥 <b>{esc(name)}</b>\n{bar(p)} {p}% · {hs(cur)} / {hs(total)}", parse_mode="html")
        except Exception:
            pass

    try:
        src = os.path.join(work, name)
        await e.download_media(file=src, progress_callback=cb)
        await msg.edit("⚙️ <b>Обрабатываю и добавляю в базу…</b>", parse_mode="html")
        st = await asyncio.get_running_loop().run_in_executor(None, process_upload, src, name, dbname)
        stats['uploads'] += 1
        save_stats()
        files, size = base_info(dbname)
        await msg.edit(
            "✅ <b>БАЗА ОБНОВЛЕНА</b>\n━━━━━━━━━━━━━━━━━━\n"
            f"📁 База: <b>{esc(dbname)}</b>\n"
            f"➕ Добавлено файлов: <b>{st['added']}</b>\n"
            f"⏭ Пропущено: <b>{st['skipped']}</b>\n"
            f"📦 Размер базы: <b>{hs(size)}</b> ({files} ф.)",
            buttons=BACK, parse_mode="html")
    except Exception as ex:
        await msg.edit(f"❌ <b>Ошибка:</b> {esc(ex)}", buttons=BACK, parse_mode="html")
    finally:
        shutil.rmtree(work, ignore_errors=True)


