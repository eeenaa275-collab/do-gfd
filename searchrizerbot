# ================= УТИЛИТЫ =================
def hs(n):
    n = float(n or 0)
    for u in ("Б", "КБ", "МБ", "ГБ", "ТБ"):
        if n < 1024:
            return f"{n:.0f} {u}" if u == "Б" else f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} ПБ"


def bar(p):
    n = max(0, min(10, p // 10))
    return "▰" * n + "▱" * (10 - n)


def safe(name):
    name = re.sub(r"[^\w\-. ]", "_", name, flags=re.UNICODE).strip(" .")
    return name[:80] or "base"


